---

---

<section id="vote" class="py-(--space-3xl) px-(--space-m) bg-navy text-white">
    <div class="max-w-(--container-lg) mx-auto text-center">
        <span class="text-gold font-callout font-semibold text-sm tracking-[0.2em] uppercase"
            >Primary Day</span
        >

        <div class="mt-6 mb-8">
            <span class="font-display text-7xl font-bold block"
                >May 12, 2026</span
            >
        </div>

        <p class="text-white text-base max-w-xl mx-auto mb-10">
            Make your voice heard for Elkhorn Public Schools in the primary
            election. Find your polling place or learn about early voting
            options.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
                href="https://www.votedouglascounty-ne.gov/voting_locations.aspx"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
            >
                Find Your Polling Place
            </a>
            <a
                href="https://www.votedouglascounty-ne.gov/early_voting.aspx"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-white"
            >
                Early Voting Info
            </a>
        </div>

        <p class="mt-8 text-white/90 text-sm">
            Douglas County Election Commission:
            <a
                href="https://www.votedouglascounty-ne.gov"
                target="_blank"
                rel="noopener noreferrer"
                class="underline hover:text-white"
            >
                votedouglascounty.com
            </a>
        </p>
    </div>
</section>
