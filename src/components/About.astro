---
import CampaignBadge from './CampaignBadge.astro';
---

<section id="about" class="py-(--space-3xl) px-(--space-m) bg-white">
  <div class="max-w-(--container-xl) mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-4 flex justify-center">
        <CampaignBadge />
      </div>

      <div class="lg:col-span-8">
        <span class="text-section-label">Meet the Candidate</span>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-navy mt-4 mb-6">
          About Emily
        </h2>

        <div class="prose prose-lg max-w-none text-black/80 space-y-4">
          <p>
            Emily Poeschl is a dedicated community member and advocate for quality public education.
            As a parent of children in Elkhorn Public Schools, she understands firsthand the importance
            of strong schools in building a thriving community.
          </p>
          <p>
            With a background in education policy and community engagement, Emily brings a unique
            perspective to school board governance. She believes in transparent leadership, fiscal
            responsibility, and putting students first in every decision.
          </p>
        </div>

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="bg-cream rounded-lg p-6">
            <h3 class="font-display font-bold text-navy text-lg mb-2">Education</h3>
            <p class="text-black/70 text-sm">
              Committed to educational excellence and preparing students for future success.
            </p>
          </div>
          <div class="bg-cream rounded-lg p-6">
            <h3 class="font-display font-bold text-navy text-lg mb-2">Community</h3>
            <p class="text-black/70 text-sm">
              Active volunteer and advocate for Elkhorn families and neighborhoods.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
