---
import PriorityCard from './PriorityCard.astro';

const priorities = [
  {
    number: "01",
    title: "Strategic Leadership, Not Politics",
    description: "The school board exists to set strategy, steward taxpayer dollars, and ensure accountability—not to manage daily school operations.",
    bullets: ["Clear long-term direction, not politics", "Oversight, not micromanagement", "Trusting and empowering educators and administrators"],
    variant: "navy" as const,
    featured: true
  },
  {
    number: "02",
    title: "Smart Planning for Growth",
    description: "Elkhorn's top-ranked schools continue to attract new families and fuel community expansion. Growth must be managed thoughtfully.",
    bullets: ["Intentional, sustainable, and scalable planning", "Prepared for future neighborhoods", "Never at the expense of excellence"],
    variant: "red" as const
  },
  {
    number: "03",
    title: "Access to Education for Every Learner",
    description: "Strong school governance must ensure equitable access to opportunity and support, so all students can thrive.",
    bullets: ["Inclusive policies for students with disabilities and diverse learning needs", "Family-centered strategies that respect diverse backgrounds", "Support for early childhood education and school readiness"],
    variant: "dark" as const
  },
  {
    number: "04",
    title: "Future-Ready Learners",
    description: "Preparing students for a world shaped by AI and rapid tech advancement, while keeping critical thinking and academic foundations strong.",
    bullets: ["Thoughtful investment in modern classroom technology", "Expanded career pathways including skilled trades and healthcare", "Partnerships with local employers to strengthen Elkhorn's workforce"],
    variant: "navy" as const
  },
  {
    number: "05",
    title: "Safe, Secure, and Supported Schools",
    description: "Safety goes beyond the school doors. Students deserve environments that protect their physical safety, mental health, and digital privacy.",
    bullets: ["Crisis preparedness and building security", "Proactive mental health support systems", "Cybersecurity policies that safeguard student information"],
    variant: "red" as const
  }
];
---

<section id="priorities" class="py-(--space-3xl) px-(--space-m) bg-cream">
  <div class="max-w-(--container-xl) mx-auto">
    <div class="text-center mb-(--space-xl)">
      <span class="text-section-label">Campaign Platform</span>
      <h2 class="font-display text-4xl md:text-5xl font-bold text-navy mt-4">
        Priorities for Elkhorn
      </h2>
      <p class="text-black/70 mt-4 max-w-3xl mx-auto">
        Through thoughtful conversations with Elkhorn families and community members, Emily has identified five core priorities that will guide her service on the Elkhorn Board of Education.
      </p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {priorities.map(priority => (
        <PriorityCard {...priority} />
      ))}
    </div>
  </div>
</section>
