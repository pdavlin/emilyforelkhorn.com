---
import Logo from './Logo.astro';
---

<div class="campaign-badge relative">
  <div class="w-48 h-48 md:w-64 md:h-64 rounded-full border-4 border-navy flex flex-col items-center justify-center bg-white shadow-lg relative">
    <div class="absolute inset-2 rounded-full border-2 border-gold/30"></div>
    <Logo size="lg" />
    <div class="mt-4 text-center">
      <span class="font-callout font-bold text-xs tracking-[0.15em] uppercase text-red block">
        Strong Schools
      </span>
      <span class="font-callout font-bold text-xs tracking-[0.15em] uppercase text-navy block">
        Strong Community
      </span>
    </div>
  </div>
</div>
