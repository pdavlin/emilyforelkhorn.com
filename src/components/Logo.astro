---
import { Image } from 'astro:assets';
import logoImage from '../assets/efe-logo.png';

interface Props {
  size?: 'sm' | 'md' | 'lg';
}

const { size = 'md' } = Astro.props;
const heights = { sm: 32, md: 48, lg: 64 };
const height = heights[size];
---

<Image
  src={logoImage}
  alt="Emily for Elkhorn"
  height={height}
  class="logo"
/>

<style>
  .logo {
    width: auto;
    height: auto;
    max-height: 100%;
  }
</style>
