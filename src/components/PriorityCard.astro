---
interface Props {
  number: string;
  title: string;
  description: string;
  bullets: string[];
  variant: 'navy' | 'red' | 'dark';
  featured?: boolean;
}

const { number, title, description, bullets, variant, featured = false } = Astro.props;

const variantClasses = {
  navy: 'bg-navy text-white',
  red: 'bg-red text-white',
  dark: 'bg-black text-white'
};
---

<article class={`priority-card rounded-xl p-8 ${variantClasses[variant]} ${featured ? 'lg:col-span-2' : ''}`}>
  <span class="text-gold font-display text-5xl font-bold opacity-50">{number}</span>
  <h3 class="font-display text-2xl font-bold mt-2 mb-4">{title}</h3>
  <p class="text-white/80 mb-6 leading-relaxed">{description}</p>
  <ul class="space-y-2">
    {bullets.map(bullet => (
      <li class="flex items-start gap-2">
        <svg class="w-5 h-5 text-gold mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span class="text-white/90">{bullet}</span>
      </li>
    ))}
  </ul>
</article>
