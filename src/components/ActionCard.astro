---
interface Props {
  title: string;
  description: string;
  icon: 'heart' | 'users' | 'home';
  buttonText: string;
  buttonUrl: string;
}

const { title, description, icon, buttonText, buttonUrl } = Astro.props;

const icons = {
  heart: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`,
  users: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />`,
  home: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />`
};
---

<div class="action-card-glass backdrop-blur-md bg-white/15 rounded-xl p-8 border border-white/20 text-center">
  <div class="w-16 h-16 rounded-full bg-white/20 flex items-center justify-center mx-auto mb-6">
    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <Fragment set:html={icons[icon]} />
    </svg>
  </div>
  <h3 class="font-display text-2xl font-bold text-white mb-3">{title}</h3>
  <p class="text-white/80 mb-6">{description}</p>
  <a href={buttonUrl} class="btn btn-white w-full">
    {buttonText}
  </a>
</div>
