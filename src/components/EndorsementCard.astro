---
interface Props {
  name: string;
  title?: string;
  icon: 'education' | 'person' | 'group' | 'business';
  placeholder?: boolean;
}

const { name, title, icon, placeholder = false } = Astro.props;

const icons = {
  education: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />`,
  person: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />`,
  group: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
  business: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />`
};
---

<div class={`endorsement-card bg-white rounded-lg p-6 shadow-sm flex items-center gap-4 ${placeholder ? 'border-2 border-dashed border-gray-light' : 'border border-gray-light'}`}>
  <div class={`w-12 h-12 rounded-full flex items-center justify-center shrink-0 ${placeholder ? 'bg-gray-light' : 'bg-navy/10'}`}>
    <svg class={`w-6 h-6 ${placeholder ? 'text-navy/30' : 'text-navy'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <Fragment set:html={icons[icon]} />
    </svg>
  </div>
  <div>
    <p class={`font-semibold ${placeholder ? 'text-navy/50' : 'text-navy'}`}>{name}</p>
    {title && <p class="text-sm text-black/60">{title}</p>}
  </div>
</div>
