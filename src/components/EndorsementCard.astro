---
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  title?: string;
  logo?: ImageMetadata;
  placeholder?: boolean;
}

const { name, title, logo, placeholder = false } = Astro.props;
---

{logo ? (
<div class="endorsement-card bg-white rounded-lg shadow-sm flex items-center justify-center border border-gray-light h-full overflow-hidden">
  <img src={logo.src} alt={name} class="w-full h-full object-contain" />
</div>
) : (
<div class={`endorsement-card bg-white rounded-lg p-6 shadow-sm flex items-center h-full ${placeholder ? 'border-2 border-dashed border-gray-light' : 'border border-gray-light'}`}>
  <div>
    <p class={`font-semibold ${placeholder ? 'text-navy/50' : 'text-navy'}`}>{name}</p>
    {title && <p class="text-sm text-black/60">{title}</p>}
  </div>
</div>
)}
