---
import EndorsementCard from './EndorsementCard.astro';
import wwrLogo from '../assets/logos/WWR-Logo.svg';
import gunSenseBadge from '../assets/logos/gun_sense_candidate.png';

const endorsements = [
  { name: "Women Who Run", logo: wwrLogo },
  { name: "Dr. Roger Breed", title: "Former EPS Superintendent; Former Nebraska Commissioner of Education" },
  { name: "Liz Renner", title: "Nebraska State Board of Education Member" },
  { name: "Kolleen Benjamin", title: "EPS Volunteer of the Year" },
  { name: "Gini Magnuson", title: "OPS Board of Education Member" },
  { name: "Tony Vargas", title: "Former OPS Board of Education Member; Former State Senator" },
  { name: "Katie Palmer", title: "Former EPS PTO Board Member" },
  { name: "Dakotah Smith", title: "Former EPS PTO Board Member" },
  { name: "Your Name Here", title: "Endorse Emily", placeholder: true },
];
---

<section id="endorsements" class="py-(--space-3xl) px-(--space-m) bg-cream relative z-1">
  <div class="max-w-(--container-xl) mx-auto">
    <div class="text-center mb-(--space-xl)">
      <span class="text-section-label">Community Support</span>
      <h2 class="font-display text-4xl font-bold text-navy mt-4">
        Endorsements
      </h2>
      <p class="text-black/70 mt-4 max-w-2xl mx-auto">
        Emily is proud to have the support of educators, community leaders, and neighbors
        who share her vision for Elkhorn Public Schools.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 auto-rows-[var(--space-3xl)]">
      {endorsements.map(endorsement => (
        <EndorsementCard {...endorsement} />
      ))}
    </div>
    <div class="text-center mt-8">
      <a href="mailto:emily@emilyforelkhorn.com?subject=Endorsement" class="btn btn-outline">
        Add Your Endorsement
      </a>
    </div>

    <div class="mt-(--space-xl) bg-white rounded-lg border border-gray-light shadow-sm px-6 py-5 flex items-center gap-6">
      <div class="flex-1">
        <p class="text-navy font-semibold text-lg">
          2026 Moms Demand Action Gun Sense Candidate
        </p>
        <p class="text-black/70 text-sm mt-1">
          The Gun Sense Candidate distinction signals to voters that, if elected, Emily will
          govern with gun safety in mind.
        </p>
        <a
          href="https://gunsensevoter.org/candidates/?usState=NE&electionYear=2026&officeLevel=local&isArchive=true"
          target="_blank"
          rel="noopener noreferrer"
          class="text-red text-sm font-semibold mt-2 inline-block hover:underline"
        >
          View Nebraska candidates &rarr;
        </a>
      </div>
      <img
        src={gunSenseBadge.src}
        alt="2026 Moms Demand Action Gun Sense Candidate badge"
        class="w-24 h-24 shrink-0 object-contain"
      />
    </div>
  </div>
</section>
